body {
    background-color: #3b3b3b;
    background-image: url("../background.jpeg");
    color: #ffffff;

    text-align: center;
}

div.dayDates {
    text-align: center;

    position: absolute;
    bottom: 0px;
    width: 100%;
}

div.dayHighs {
    font-size: 20px;
    text-align: right;

    padding: 0px 5px 0px 5px;
}

div.dayIcons {
    font-family: weatherIcons;
    font-size: 30px;

    float: left;
    padding: 5px 5px 5px 5px;
}

div.daysInt {
    border-style: solid;
    border-color: #80808055;
    border-width: 0px;
    border-left-width: 1px;
    border-right-width: 1px;

    position: relative;
    height: 100%;
    width: 20%;
    display: table-cell;
}

div.dayLows {
    font-size: 20px;
    text-align: right;

    padding: 0px 5px 0px 0px;
}

div.labels {
    text-align: left;

    float: left;
    clear: left;
    width: 125px;
}

div.priceLabels {
    font-family: monospace;
    font-size: 20px;
    text-align: left;

    float: left;
    clear: left;
    width: 75px;
}

div.subPrice {
    font-family: monospace;
    font-size: 20px;
    text-align: right;

    float: right;
    clear: right;
}

@font-face {
    font-family: weatherIcons;
    src: url(../fonts/weathericons-regular-webfont.ttf);
}

#centerMain {
    display: inline-block;
    height: 100%;
    vertical-align: middle;
    margin-right: -0.25em;
    content: '';
}

#contents {
    float: left;
    box-sizing: border-box;
    flex: 1;
    height: 100%;
    padding: 10px 10px 10px 10px;
}

#coords {
    font-family: monospace;
    font-size: 10px;
    white-space: nowrap;
    text-align: left;

    position: relative;
}

#current {
    height: 100%;
    float: left;
    clear: left;
}

#currentPrice {
    float:left;
    clear:left;
}

#day1 {
    border-style: solid;
    border-color: #80808055;
    border-width: 0px;
    border-right-width: 1px;

    position: relative;
    height: 100%;
    width: 20%;
    display: table-cell;
}

#day5 {
    border-style: solid;
    border-color: #80808055;
    border-width: 0px;
    border-left-width: 1px;

    position: relative;
    height: 100%;
    width: 20%;
    display: table-cell;
}

#ethContents {
    display: flex;
    position: relative;
    height: 100%;
    width: auto;
    padding: 10px;
}

#ether {
    background-color: #3b3b3bcf;

    color: #b7b7b7;

    min-width: 550px;
    margin-top: 20px;

    border-style: solid;
    border-radius: 10px;
    border-width: 0px;
}

#etherLabel {
    font-family: monospace;
    font-size: 48px;
    text-align: left;

    float: left;
    clear: left;
}

#future {
    background-color: #3b3b3b00;

    font-family: monospace;

    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-style: solid;
    border-color: #80808055;
    border-width: 0px;
    border-top-width: 2px;

    display: table;
    position: relative;
    height: 70px;
    width: 100%;
}

#hourPrice {
    height: 100%;
    float: right;
    clear: right;
    padding-left: 20px;
}

#humid {
    text-align: right;

    float: right;
    clear: right;
}

#icon {
    font-family: weatherIcons;
    font-size: 80px;

    box-sizing: border-box;
    padding: 10px 10px 10px 10px;
    width: auto;
    float: left;
}

#internal {
    display: flex;
    position: relative;
}

#main {
    display: inline-block;
    vertical-align: middle;
}

#misc {
    height: 100%;
    float: right;
    padding-left: 20px;

    font-family: monospace;
    font-size: 12px;
}

#name {
    font-family: monospace;
    font-size: 24px;
    font-weight: bold;
    text-align: left;
    white-space: nowrap;

    position: relative;
}

#precip {
    text-align: right;

    float: right;
    clear: right;
}

#pressure {
    text-align: right;

    float: right;
    clear: right;
}

#price {
    text-align: left;
    font-family: monospace;
    font-size: 48px;

    float: right;
    clear: right;
}

#temp {
    font-family: monospace;
    font-size: 72px;
    text-align: left;

    position: relative;
    bottom: -10px;
}

#time {
    font-family: monospace;
    font-size: 8px;

    position: absolute;
    clear: both;
    bottom: 0px;
    right: 10px;
}

#weather {
    background-color: #3b3b3bcf;

    color: #b7b7b7;

    margin: auto;
    min-width: 550px;

    border-radius: 10px;
}

#wind {
    text-align: right;

    float: right;
    clear: right;
}

#windIcon {
    font-family: weatherIcons;
    font-size: 40px;
    text-align: right;
}
